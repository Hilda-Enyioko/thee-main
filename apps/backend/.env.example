# Security & App Configuration
SECRET_KEY=your_secret_key_here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://user:password@host:port/dbname
DIRECT_DATABASE_URL=postgresql://user:password@host:port/dbname

# Celery & Redis
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Anthropic / Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_TIMEOUT_SECONDS=60
CLAUDE_MAX_RETRIES=2

# Paystack
PAYSTACK_SECRET_KEY=sk_test_key
PAYSTACK_PUBLIC_KEY=pk_test_key
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=https://your-frontend-domain.com/payments/callback/

# N8N Webhooks
N8N_WEBHOOK_PAYMENT_URL=https://your-username.app.n8n.cloud/webhook/payment-confirmed
N8N_WEBHOOK_DUNNING_URL=https://your-insurance.app.n8n.cloud/webhook-test/charge-failed

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend
RESEND_API_KEY=re_api_key
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# Cron
FIELD_ENCRYPTION_KEYS=field_key
PUBLIC_API_BASE_URL=backend_api_url
CRON_TRIGGER_SECRET=cron_trigger_secret
CRON_SECRET_KEY=cron_secret_key